# Cloudflare Pages 헤더. 같은 헤더를 여러 규칙이 설정하면 값이 쉼표로 이어 붙으므로(문서 확인), 캐시 규칙이 서로 겹치지 않게 나눈다.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# 매번 새 버전을 확인하는 파일 (HTML, 게임 코드, 문서)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/privacy.html
  Cache-Control: no-cache
/THIRD-PARTY-NOTICES.txt
  Cache-Control: no-cache
/src/*
  Cache-Control: no-cache

# 며칠 캐시하는 파일 (이미지, 소리, 글꼴, 라이브러리, 아이콘)
/assets/*
  Cache-Control: public, max-age=259200
/lib/*
  Cache-Control: public, max-age=259200
/favicon.png
  Cache-Control: public, max-age=259200
/apple-touch-icon.png
  Cache-Control: public, max-age=259200
/og-image.png
  Cache-Control: public, max-age=259200
